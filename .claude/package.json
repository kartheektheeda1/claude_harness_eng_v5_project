{
  "name": "claimflow-claude-harness",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-dependency validators, hooks, and contract tests for the ClaimFlow Claude harness.",
  "type": "commonjs",
  "scripts": {
    "test": "node --test",
    "validate": "node scripts/validate-harness.js",
    "validate:bootstrap": "node scripts/validate-harness.js --allow-missing-specs",
    "validate:specs": "node scripts/validate-specs.js",
    "status": "node scripts/status.js"
  },
  "engines": {
    "node": ">=20"
  }
}
